    "admin:create": "tsx src/db/create_admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "google-auth-library": "^11.3.1",
    "hono": "^4.7.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.9",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
