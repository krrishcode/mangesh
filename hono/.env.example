PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:4000
JWT_SECRET=
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
COD_ENABLED=true
SHIPPING_FEE_INR=0

# Configure SMTP to enable password recovery. No reset token is ever returned.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Only used by the explicit admin:create command. No default account is seeded.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Google Identity Services web client (optional until configured)
GOOGLE_CLIENT_ID=
