# Server runtime (Next.js route handlers and server components)
APP_ORIGIN=http://localhost:3000
JWT_SECRET=

DB_CONN_LIMIT=5

COD_ENABLED=true
SHIPPING_FEE_INR=0

# Configure SMTP for email verification codes and password recovery.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@mangeshmahadev.com
SMTP_PASSWORD=
SMTP_FROM=notifications@mangeshmahadev.com
SMTP_REPLY_TO=support@mangeshmahadev.com
SUPPORT_EMAIL=support@mangeshmahadev.com
SUPPORT_PHONE=+919764002240
# Optional separate origin for links in emails. Set to the live HTTPS site in production.
EMAIL_APP_ORIGIN=

# Local development only: accept any six-digit OTP on loopback hosts without SMTP.
# Always ignored in production, and when SMTP is configured.
AUTH_OTP_DEV_BYPASS=false

# Google Identity Services web client (optional until configured)
GOOGLE_CLIENT_ID=

# Cloudflare R2: bucket-scoped Object Read & Write credentials (server only).
R2_ACCOUNT_ID=
R2_BUCKET=mangesh-mahadev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://cdn.mangeshmahadev.com
# VPS media worker only: zone-scoped Cache Purge permission.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_TOKEN=

# Optional shared rate-limit store. Without these the API uses a per-instance
# in-memory fallback, which is best-effort on serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only used by the explicit admin:create command. No default account is seeded.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# PostgreSQL runtime connection (TLS is required for a remote host)
POSTGRES_URL=
POSTGRES_CA_FILE=
# Optional administrative URL for future schema migrations
POSTGRES_MIGRATION_URL=
