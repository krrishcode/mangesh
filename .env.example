# Server runtime (Next.js route handlers and server components)
APP_ORIGIN=http://localhost:3000
JWT_SECRET=

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ecommerce
DB_CONN_LIMIT=5

COD_ENABLED=true
SHIPPING_FEE_INR=0

# Configure SMTP to enable password recovery. No reset token is ever returned.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google Identity Services web client (optional until configured)
GOOGLE_CLIENT_ID=

# Vercel Blob for admin product image uploads. Vercel injects this when a Blob
# store is connected; add it manually for other Node deployments.
BLOB_READ_WRITE_TOKEN=

# Optional shared rate-limit store. Without these the API uses a per-instance
# in-memory fallback, which is best-effort on serverless deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only used by the explicit admin:create command. No default account is seeded.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
